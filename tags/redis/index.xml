	<thead>
			<tr>
					<th>问题</th>
					<th>发生了什么</th>
			</tr>
	</thead>
	<tbody>
			<tr>
					<td>缓存穿透</td>
					<td>请求的数据根本不存在</td>
			</tr>
			<tr>
					<td>缓存击穿</td>
					<td>一个热点 Key 刚好失效</td>
			</tr>
			<tr>
